{
  "name": "poc-kit",
  "version": "0.4.0",
  "description": "Build one self-contained, offline, design-system-styled interactive POC from a requirement — mocked logic, verified by driving it in a headless browser.",
  "type": "module",
  "bin": {
    "poc-kit": "bin/poc-kit.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "schema",
    "README.md"
  ],
  "scripts": {
    "check": "node --check bin/poc-kit.mjs && for f in src/*.mjs; do node --check \"$f\"; done",
    "lint": "eslint .",
    "test": "node --test \"test/unit/**/*.test.mjs\"",
    "test:e2e": "node --test \"test/e2e/**/*.test.mjs\"",
    "check:docs": "node scripts/check-docs.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "check:version": "node scripts/check-version-bump.mjs",
    "ci": "npm run check && npm run lint && npm test && npm run check:docs && npm run check:pack",
    "prepublishOnly": "npm run check",
    "release": "npm version patch -m \"cli: v%s\" --tag-version-prefix=poc-kit-v && git push --follow-tags && npm publish"
  },
  "keywords": [
    "prototype",
    "poc",
    "proof-of-concept",
    "wireframe",
    "mockup",
    "design-system",
    "offline",
    "demo",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/havesomeleeway/poc-toolkit.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/havesomeleeway/poc-toolkit#readme",
  "bugs": {
    "url": "https://github.com/havesomeleeway/poc-toolkit/issues"
  },
  "license": "MIT",
  "dependencies": {
    "chrome-remote-interface": "^0.33.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "ajv": "^8.20.0",
    "eslint": "^9.39.5",
    "globals": "^17.12.0"
  }
}
